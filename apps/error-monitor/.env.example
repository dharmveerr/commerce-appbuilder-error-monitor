# Copy to .env (git-ignored). Generic placeholders only - never commit real values.
AIO_runtime_namespace=
AIO_runtime_auth=

COMMERCE_INSTANCE_ID=stage-instance-1
# >= 32 random chars, e.g. `openssl rand -hex 32`. Shared with consumer apps via THEIR .env.
INGEST_SIGNING_KEY=
IMS_ORG_ID=<org-id>@AdobeOrg

STATE_TTL_SECONDS=604800
ARCHIVE_ENABLED=true

# Adobe I/O Events (optional; set EVENT_PROVIDER_ID to enable)
EVENTS_ENABLED=
EVENT_PROVIDER_ID=
EVENT_CODE=com.example.commerce.error_monitor.error_recorded
EVENT_MIN_SEVERITY=error
IMS_CLIENT_ID=
IMS_CLIENT_SECRET=
IMS_SCOPES=openid,AdobeID,adobeio_api
