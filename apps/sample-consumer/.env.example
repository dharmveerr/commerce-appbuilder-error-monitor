# Generic placeholders. Copy to .env (git-ignored).
AIO_runtime_namespace=
AIO_runtime_auth=
# URL of the deployed error-monitor/record-error web action
ERROR_MONITOR_ENDPOINT=https://<namespace>.adobeioruntime.net/api/v1/web/error-monitor/record-error
# Same value as INGEST_SIGNING_KEY in the Error Monitor app
ERROR_MONITOR_SIGNING_KEY=
# Demo-only: a fake upstream token, used to prove secrets do not reach the monitor
UPSTREAM_TOKEN=demo-not-a-real-token
